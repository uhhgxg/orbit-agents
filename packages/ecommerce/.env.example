ECOMMERCE_ROLE=reviewer
ECOMMERCE_REPLAY=true
# Real-time freshness checks: set ECOMMERCE_REPLAY=false outside fixed-snapshot demos.
# ECOMMERCE_STATE_DIR=absolute-path-to-private-state
# ECOMMERCE_API_BASE_URL=https://your-adapter.example.com/
# ECOMMERCE_API_TOKEN=configure-outside-source-control
# Optional: Langfuse Cloud or self-hosted v4.59.0+ for SDK v6.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=
# Optional judge: configure an OpenAI-compatible chat completions URL and your model.
# EVAL_JUDGE_URL=
# EVAL_JUDGE_API_KEY=
# EVAL_JUDGE_MODEL=
# ECOMMERCE_OPERATOR_AUTH belongs only in the operator process, never the MCP environment.
